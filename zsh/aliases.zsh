alias scb=". ~/.bashrc"
alias scz=". ~/.config/zsh/.zshrc"

alias gcm="git commit -m "
alias ga="git add"
alias gac="git add . && git commit -m"
alias gst="git status"
alias gl="git log --oneline"

alias ls="eza -h "
alias lsa="eza -ha --color=auto --icons=auto --git"
alias ll="eza -lh --color=auto --group-directories-first --icons=auto "
alias lla="eza -lha --color=auto --group-directories-first --icons=auto --git "
alias lt="eza --tree --icons=auto"

alias rm="rm -i "
alias cp="cp -i "

alias grep="rg --color=auto "
alias bat="batcat"
alias cat="bat -n"

alias diff="diff --color=auto"
alias df="df -h"

alias untar="tar -zxvf "


alias update="sudo apt update && sudo apt upgrade"
